{
  "name": "cookllm",
  "private": true,
  "version": "0.4.3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:inference && npm run test:estimator && npm run test:ninfer",
    "test:inference": "tsc -p tsconfig.test.json && node -e \"require('fs').writeFileSync('.test-dist/package.json',JSON.stringify({type:'commonjs'}))\" && node .test-dist/test/inference-regression.test.js",
    "test:estimator": "tsc -p tsconfig.test.json && node -e \"require('fs').writeFileSync('.test-dist/package.json',JSON.stringify({type:'commonjs'}))\" && node .test-dist/test/profile-estimator.test.js",
    "test:ninfer": "tsc -p tsconfig.test.json && node -e \"require('fs').writeFileSync('.test-dist/package.json',JSON.stringify({type:'commonjs'}))\" && node .test-dist/test/ninfer-estimator.test.js",
    "preview": "vite preview",
    "tauri": "tauri",
    "release:check": "node scripts/release.mjs check",
    "release:bump": "node scripts/release.mjs bump",
    "release": "node scripts/release.mjs publish"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
